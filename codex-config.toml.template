# ~/.codex/config.toml в dev-контейнере __CONTAINER__.
#
# Засевается claude-dev-ctl ОДИН РАЗ — при создании контейнера. Дальше файл твой:
# retrofit его не трогает, потому что сюда попадают решения, которые кит знать не
# может (какие каталоги ты доверил codex). Перезаписать шаблоном:
#   claude-dev-ctl retrofit dev-__CONTAINER__ --force

# Модель и усилие для ручных вызовов `codex`. В цикле ralphex они не действуют:
# там модель и песочницу задаёт ~/.config/ralphex/config и передаёт флагами.
model = "gpt-5.6-sol"
model_reasoning_effort = "high"

# Песочницу для интерактивной работы намеренно не задаём: дефолт codex
# (workspace-write со спросом на выход за пределы каталога) — разумная середина,
# а прописанный тут read-only сделал бы ручной codex бесполезным.

# Доверенные каталоги: в них codex не переспрашивает на каждый шаг. Прописывай
# по проекту, а не на весь /workspace — доверие должно быть решением, а не фоном.
#
# [projects."/workspace/<проект>"]
# trust_level = "trusted"
