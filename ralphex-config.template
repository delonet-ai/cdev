# ~/.config/ralphex/config в dev-контейнере __CONTAINER__ (INI).
#
# Засевается claude-dev-ctl ОДИН РАЗ — при создании контейнера; дальше файл твой.
# Полный список параметров с дефолтами ralphex пишет сюда сам закомментированным,
# когда запускается впервые. Перезаписать шаблоном:
#   claude-dev-ctl retrofit dev-__CONTAINER__ --force
#
# Фаза внешнего ревью включена: план выполняет Claude Code, найденное перепроверяет
# codex — независимая модель ловит то, на что у автора замылен глаз.
# Если codex не авторизован (нет ~/.codex/auth.json), поставь codex_enabled = false,
# иначе цикл будет спотыкаться на каждой фазе ревью.

external_review_tool = codex
codex_enabled = true
codex_command = codex
codex_model = gpt-5.6-sol
codex_reasoning_effort = high

# Ревьюеру нужен полный доступ, а не read-only: чтобы проверить замечание, он
# запускает тесты и линтеры, а под read-only это упирается в запрет записи, и
# ревью вырождается в чтение диффа. Реальная граница здесь — сам контейнер: в нём
# уже работает Claude Code с --dangerously-skip-permissions, так что ужесточать
# песочницу одного лишь ревьюера — иллюзия защиты, а не защита.
#
# Чем это НЕ ограничено, помни: в контейнере лежат ssh-ключ на хост и DOCKER_HOST,
# смотрящий на прод. Границу держат правила в ~/.claude/CLAUDE.md, а не песочница.
codex_sandbox = danger-full-access

# Планы лежат в репозитории проекта, а не в $HOME.
plans_dir = docs/plans
